{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"plugins": ["typescript", "unicorn", "import"],
	"rules": {
		"sort-imports": "off",
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
		"typescript/no-unsafe-type-assertion": "off",
		"typescript/restrict-template-expressions": "off",
		"typescript/prefer-nullish-coalescing": "warn",
		"consistent-return": "error",
		"no-console": "warn",
		"import/no-duplicates": "error"
	},
	"overrides": [
		{
			"files": ["src/analysis/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"#server/**",
									"#web/**",
									"**/server/**",
									"**/web/**",
									"react",
									"react-dom",
									"react/**",
									"react-dom/**",
									"@tanstack/**"
								],
								"message": "The analysis engine stays independent of the server commands, the web app and its framework."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": ["dist", "node_modules", "**/*.d.ts", "**/routeTree.gen.ts"]
}
