{
	"name": "observatory",
	"description": "Open-source market observatory that explains what changed and surfaces potential opportunities.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/analysis/lib/*",
		"#modules/*": "./src/analysis/modules/*",
		"#server/*": "./src/server/*",
		"#web/*": "./src/web/*"
	},
	"scripts": {
		"dev": "bun --bun astro dev",
		"build": "bun --bun astro build",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"test": "bun test",
		"test:storage-integration": "bun test src/analysis/modules/bar-history/storage/bar-history-storage.integration.test.ts",
		"analyze": "bun src/server/analysis-run/analysis-run.ts",
		"canary:bar-history": "bun src/server/bar-history-canary/bar-history-canary.ts",
		"generate:catalog": "bun src/server/instrument-catalog-generator/instrument-catalog-generator.ts",
		"observe": "bun src/server/bymadata-observer/bymadata-observer.ts",
		"snapshot:history": "bun src/server/bymadata-history-snapshot/bymadata-history-snapshot.ts"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.1",
		"astro": "^7.3.8",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"railway": "^3.13.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"engines": {
		"bun": ">=1.4"
	},
	"packageManager": "bun@1.4.2"
}
